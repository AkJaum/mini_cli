# Bind da API e diretório de clones
PORT=8080
WORKDIR_BASE=/tmp/runner-workspaces
# Padrão é config.json na raiz. No Docker do Render, defina o caminho abaixo no painel.
# PROJECT_CONFIG_PATH=/etc/secrets/config.json

# Troque os dois valores antes de expor o serviço
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,project-runner
RUNNER_SHARED_TOKEN=replace-with-a-long-random-runner-token

# HTTP, leitura de arquivos e saída dos processos (bytes)
DATA_UPLOAD_MAX_MEMORY_SIZE=262144
MAX_FILE_SIZE_BYTES=8388608
MAX_OUTPUT_BYTES=262144

# Tempo de operações (milissegundos) e quantidade de argumentos
CLONE_TIMEOUT_MS=30000
BUILD_TIMEOUT_MS=30000
RUN_TIMEOUT_MS=10000
MAX_BUILD_ARGS=8
MAX_RUN_ARGS=32

# Limites de chamadas (tempo em segundos)
MAX_REQUESTS_PER_ID_PER_MINUTE=120
RATE_WINDOW_SECONDS=60
MAX_CONCURRENT_REQUESTS_PER_ID=6
MAX_GLOBAL_CONCURRENT_REQUESTS=64
PENDING_REQUEST_TTL_SECONDS=30

# Terminal interativo (bytes e segundos)
MAX_PTY_INPUT_BYTES=4096
MAX_PTY_BUFFER_BYTES=524288
PTY_MAX_LIFETIME_SECONDS=300
